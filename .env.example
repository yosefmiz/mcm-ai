# ---------------------------------------------------------------------------
# MyHome — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL="postgresql://user:PASSWORD@localhost:5432/mcm_ai?schema=public"

# Local Ollama server (default port 11434). Change only if you remapped it.
OLLAMA_URL="http://localhost:11434"

# Model tag as it appears in `ollama list` (e.g. gemma4, gemma4:e4b).
OLLAMA_MODEL="gemma4"

# Next.js dev/start port. The npm scripts already pin -p 3200; this is here
# only if some tooling reads PORT directly.
PORT=3200
