// MyHome — multi-language real-estate contract generator.
// Architecture v2: "Holy Trinity" — every contract is authored natively in
// three languages simultaneously. No machine translation; the LLM composes
// each column directly so legal style is correct in each jurisdiction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContractType {
  ANNUAL
  SUBLET
  MANAGEMENT
}

enum Language {
  HE
  EN
  RU
  AR
}

enum Operation {
  GENERATE
  EDIT
  CHAT
}

// ---------------------------------------------------------------------------
// Contract — the generated agreement.
// `sections` is JSONB, an array of objects matching ContractSectionSchema:
//   { id, content_legal, content_bridge, content_ui }
// ---------------------------------------------------------------------------

model Contract {
  id           String       @id @default(cuid())
  jurisdiction String
  type         ContractType

  jurisdictionLanguage String
  bridgeLanguage       String
  uiLanguage           String

  metadata     Json
  sections     Json

  // Optional link to the Deal that produced this contract. Stateful
  // generation flow sets this; ad-hoc / chat-initiated generation leaves
  // it null.
  dealId       String?
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  uiLanguageAcceptedAt DateTime?
  acceptedByUserId     String?
  userIpAddress        String?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  usageLogs    UsageLog[]

  @@index([jurisdiction, type])
  @@index([jurisdictionLanguage])
  @@index([acceptedByUserId])
  @@index([dealId])
}

// ---------------------------------------------------------------------------
// CRM entities — the stateful side of the system. The contract generator
// pulls "deal facts" from here instead of trusting a free-form payload.
// ---------------------------------------------------------------------------

model Landlord {
  id          String     @id @default(cuid())
  fullName    String
  idNumber    String?
  email       String?
  phone       String?
  address     String?
  notes       String?

  properties  Property[]
  deals       Deal[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([fullName])
}

model Tenant {
  id          String   @id @default(cuid())
  fullName    String
  idNumber    String?
  email       String?
  phone       String?
  address     String?
  notes       String?

  deals       Deal[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fullName])
}

model Property {
  id           String   @id @default(cuid())
  address      String
  unit         String?
  city         String
  jurisdiction String

  rooms        Int?
  bathrooms    Int?
  areaSqm      Int?
  furnished    Boolean  @default(false)
  parking      Boolean  @default(false)
  description  String?

  ownerId      String?
  owner        Landlord? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  deals        Deal[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([jurisdiction])
  @@index([ownerId])
}

model Deal {
  id            String       @id @default(cuid())

  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  landlordId    String
  landlord      Landlord     @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  contractType  ContractType @default(ANNUAL)

  monthlyRent   Decimal?     @db.Decimal(12, 2)
  rentCurrency  String       @default("ILS")
  depositAmount Decimal?     @db.Decimal(12, 2)

  startDate     DateTime?
  endDate       DateTime?
  termMonths    Int?

  notes         String?

  contracts     Contract[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([propertyId])
  @@index([tenantId])
  @@index([landlordId])
}

// ---------------------------------------------------------------------------
// LegalConstraint — global rules engine. Rules are written in English
// (the bridge language across our prompt layer) and the model is responsible
// for honoring them in every column it generates.
// ---------------------------------------------------------------------------

model LegalConstraint {
  id           String        @id @default(cuid())
  jurisdiction String
  language     Language?
  type         ContractType?

  category     String
  rule         String
  citation     String?
  priority     Int           @default(0)
  isActive     Boolean       @default(true)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([jurisdiction, type, isActive])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Glossary — rigid per-jurisdiction terminology. Forces the model to use
// the exact phrase a regulator or court expects. Example:
//   (jurisdiction=IL, language=he, term=security_deposit)
//     -> rigidValue = "פיקדון לבטחון"
// At generation time we inject the relevant rows and instruct the model to
// use the rigid value verbatim wherever the concept appears.
// ---------------------------------------------------------------------------

model Glossary {
  id           String   @id @default(cuid())
  jurisdiction String
  language     String
  term         String
  rigidValue   String
  notes        String?
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([jurisdiction, language, term])
  @@index([jurisdiction, language, isActive])
}

// ---------------------------------------------------------------------------
// ContractTemplate — reference exemplars used as structural anchors during
// generation. Sections still use the legacy single-content schema (id, title,
// content) because templates are uploaded raw documents in one language.
// ---------------------------------------------------------------------------

model ContractTemplate {
  id           String       @id @default(cuid())

  jurisdiction String
  language     Language
  type         ContractType

  title        String
  source       String       @unique
  rawText      String       @db.Text
  sections     Json

  isActive     Boolean      @default(true)
  priority     Int          @default(0)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([jurisdiction, type, language, isActive])
}

// ---------------------------------------------------------------------------
// UsageLog — per-call telemetry: tokens, latency, cost.
// ---------------------------------------------------------------------------

model UsageLog {
  id           String       @id @default(cuid())

  contractId   String?
  contract     Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)

  operation    Operation
  sectionId    String?

  model        String
  jurisdiction String
  language     Language
  type         ContractType

  inputTokens  Int          @default(0)
  outputTokens Int          @default(0)
  totalTokens  Int          @default(0)
  durationMs   Int          @default(0)
  costUsd      Decimal      @default(0) @db.Decimal(12, 6)

  status       String       @default("OK")
  error        String?

  createdAt    DateTime     @default(now())

  @@index([contractId])
  @@index([operation, createdAt])
  @@index([createdAt])
}
